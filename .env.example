# ---- Database ----
POSTGRES_USER=applypad
POSTGRES_PASSWORD=applypad
POSTGRES_DB=applypad
DATABASE_URL=postgresql://applypad:applypad@localhost:5432/applypad?schema=public

# ---- API (NestJS) ----
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# 운영에서는 반드시 긴 랜덤 문자열로 교체 (예: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
# 운영(HTTPS)에서는 true
COOKIE_SECURE=false

# ---- Google OAuth (비워두면 Google 로그인만 비활성화) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 웹(/api 프록시)을 거치는 주소. Google Cloud Console의 "승인된 리디렉션 URI"에 그대로 등록
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---- 운영 전용 메모 ----
# 배포 시에는 COOKIE_SECURE=true, 긴 JWT_ACCESS_SECRET, 운영 도메인의 WEB_ORIGIN/GOOGLE_CALLBACK_URL을 쓴다 (docs/DEPLOY.md)
# 아래는 앱이 아니라 데모 계정 정리 스크립트(pnpm demo:cleanup)만 읽는 값이라 env.ts 검증 대상이 아니다
DEMO_RETENTION_DAYS=7
